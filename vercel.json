{
  "rewrites": [
    {
      "source": "/api/session/:path*",
      "destination": "/api/session"
    },
    {
      "source": "/api/market/:path*",
      "destination": "/api/market"
    },
    {
      "source": "/api/order/:path*",
      "destination": "/api/order"
    },
    {
      "source": "/api/accounts/:path*",
      "destination": "/api/accounts"
    },
    {
      "source": "/api/debug/:path*",
      "destination": "/api/debug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
